{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NEXT_PUBLIC_API_BASE_URL"],
  "globalPassThroughEnv": ["NODE_ENV", "HOST", "PORT", "LOG_LEVEL", "DATABASE_URL"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "types:generate": {
      "dependsOn": ["^build"],
      "inputs": ["app/**", "next.config.ts"],
      "outputs": ["next-env.d.ts", ".next/types/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate", "types:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/types/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate", "types:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "db:generate", "types:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate", "types:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate", "types:generate"]
    },
    "@repo/e2e#test": {
      "dependsOn": []
    },
    "@repo/e2e#dev": {
      "dependsOn": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/**", "$TURBO_ROOT$/docker-compose.yml"],
      "outputs": ["playwright-report/**"],
      "passThroughEnv": ["PLAYWRIGHT_*", "CI"]
    }
  }
}
