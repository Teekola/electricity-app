{
  "name": "@repo/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "~5.12.1",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "~24.13.3",
    "eslint": "~9.39.5",
    "pino-pretty": "~13.1.3",
    "tsx": "~4.23.13",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
